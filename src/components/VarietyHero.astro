---
import { Image } from 'astro:assets';
import { getVarietyImages } from '../lib/images';
import { ripeningLabel, typeLabel, categoryPath, categoryLabelPlural } from '../lib/labels';
import Badge from './Badge.astro';

interface Props { data: any; }
const { data } = Astro.props;
const images = getVarietyImages(data.slug);
const main = images[0];
const gallery = images.slice(1);
const isTomato = data.category === 'tomato';
const tone = isTomato ? 'tomato' : 'pepper';
---
<div class="grid md:grid-cols-2 gap-5 md:gap-8">
  <div class="space-y-2.5 sm:space-y-3 -mx-4 sm:mx-0">
    {main && (
      <div class="aspect-[4/3] overflow-hidden sm:rounded-3xl ring-1 ring-black/5 bg-[var(--color-surface)] relative">
        <Image
          src={main}
          alt={data.name}
          widths={[480, 720, 960, 1200]}
          sizes="(max-width: 768px) 100vw, 50vw"
          loading="eager"
          class="absolute inset-0 object-cover"
          style="width: 100%; height: 100%; object-position: center 55%;"
        />
      </div>
    )}
    {gallery.length > 0 && (
      <div class="grid grid-cols-3 gap-2 px-4 sm:px-0">
        {gallery.map((img) => (
          <div class="aspect-square overflow-hidden rounded-lg sm:rounded-xl ring-1 ring-black/5 bg-[var(--color-surface)] relative">
            <Image
              src={img}
              alt={`${data.name} — додаткове фото`}
              widths={[160, 240]}
              sizes="33vw"
              loading="lazy"
              class="absolute inset-0 object-cover"
              style="width: 100%; height: 100%; object-position: center 60%;"
            />
          </div>
        ))}
      </div>
    )}
  </div>
  <div>
    <nav class="text-sm text-[var(--color-muted)] mb-2 mt-2 md:mt-0">
      <a href="/" class="hover:underline">Головна</a>
      <span aria-hidden="true"> › </span>
      <a href={categoryPath(data.category)} class="hover:underline">{categoryLabelPlural(data.category)}</a>
      <span aria-hidden="true"> › </span>
      <span class="text-[var(--color-text)]">{data.name}</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight mb-3">{data.name}</h1>
    <div class="flex flex-wrap gap-2 mb-4">
      <Badge tone={tone}>{ripeningLabel(data.ripening)}</Badge>
      {data.type && <Badge tone="leaf">{typeLabel(data.type)}</Badge>}
      {data.fruit?.weight_g && data.fruit.weight_g !== 'уточнюється' && <Badge tone="neutral">{data.fruit.weight_g} г</Badge>}
      {data.height_cm && data.height_cm !== 'уточнюється' && <Badge tone="neutral">{data.height_cm} см</Badge>}
      {data.confidence === 'low' && <Badge tone="neutral">дані уточнюються</Badge>}
    </div>
    {data.notes && (
      <p class="text-sm text-[var(--color-muted)] bg-[var(--color-bg-soft)] ring-1 ring-black/5 rounded-xl p-3 sm:p-4 mb-4">
        <strong class="font-semibold not-italic text-[var(--color-text)]">Примітка:</strong> {data.notes}
      </p>
    )}
  </div>
</div>
