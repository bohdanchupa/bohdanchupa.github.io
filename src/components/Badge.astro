---
interface Props {
  tone?: 'tomato' | 'leaf' | 'pepper' | 'neutral';
  icon?: string;
}
const { tone = 'neutral', icon } = Astro.props;
const tones: Record<string, string> = {
  tomato: 'bg-[#FEE2E2] text-[var(--color-tomato-dark)] ring-[var(--color-tomato)]/15',
  leaf: 'bg-[#DCFCE7] text-[var(--color-leaf-dark)] ring-[var(--color-leaf)]/15',
  pepper: 'bg-[#FED7AA] text-[#9A3412] ring-[var(--color-pepper)]/15',
  neutral: 'bg-white text-[var(--color-text)] ring-black/10',
};
---
<span class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-sm font-medium ring-1 ${tones[tone]}`}>
  {icon && <span aria-hidden="true">{icon}</span>}
  <slot />
</span>
