---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getVarietyImages } from '../lib/images';
import { categoryPath } from '../lib/labels';

const all = await getCollection('varieties');

type Photo = {
  slug: string;
  fullName: string;
  image: any;
  index: number;
  variantLabel: string | null;
};

type Group = {
  baseName: string;
  category: 'tomato' | 'pepper';
  photos: Photo[];
};

function baseName(name: string): string {
  return name.replace(/\s*\(.*?\)\s*$/, '').trim();
}

function variantLabel(name: string): string | null {
  const m = name.match(/\(([^)]+)\)\s*$/);
  return m ? m[1] : null;
}

const sorted = [...all].sort((a, b) => a.data.name.localeCompare(b.data.name, 'uk'));

const groupMap = new Map<string, Group>();
for (const v of sorted) {
  const key = `${v.data.category}:${baseName(v.data.name)}`;
  if (!groupMap.has(key)) {
    groupMap.set(key, {
      baseName: baseName(v.data.name),
      category: v.data.category,
      photos: [],
    });
  }
  const group = groupMap.get(key)!;
  const images = getVarietyImages(v.data.slug);
  images.forEach((img, i) => {
    group.photos.push({
      slug: v.data.slug,
      fullName: v.data.name,
      image: img,
      index: i,
      variantLabel: variantLabel(v.data.name),
    });
  });
}

const tomatoGroups = [...groupMap.values()]
  .filter((g) => g.category === 'tomato')
  .sort((a, b) => a.baseName.localeCompare(b.baseName, 'uk'));

const pepperGroups = [...groupMap.values()]
  .filter((g) => g.category === 'pepper')
  .sort((a, b) => a.baseName.localeCompare(b.baseName, 'uk'));

const totalPhotos = [...groupMap.values()].reduce((acc, g) => acc + g.photos.length, 0);
---
<Base
  title="Галерея"
  description="Усі фото сортів помідорів і перцю — каталог Ігоря, Львів."
>
  <article class="max-w-6xl mx-auto px-4 py-10 sm:py-14">
    <nav class="text-sm text-[var(--color-muted)] mb-4">
      <a href="/" class="hover:underline">Головна</a> <span aria-hidden="true">›</span> Галерея
    </nav>
    <span class="section-eyebrow">Фото · {totalPhotos} знімків</span>
    <h1 class="text-4xl sm:text-5xl font-extrabold mb-3">Галерея</h1>
    <p class="text-lg text-[var(--color-muted)] mb-10 max-w-2xl">
      Усі фото сортів — справжні кущі та плоди з мого городу. Натисни на фото — побачиш повний опис сорту.
    </p>

    <section class="mb-14">
      <div class="flex items-end justify-between gap-4 mb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold flex items-center gap-2">
          <span aria-hidden="true">🍅</span>
          Помідори
          <span class="text-base font-medium text-[var(--color-muted)] ml-1">· {tomatoGroups.length} сорт{tomatoGroups.length === 1 ? '' : 'ів'}</span>
        </h2>
        <a href="/pomidory" class="hidden sm:inline-flex items-center gap-1 text-[var(--color-tomato-dark)] font-semibold hover:gap-2 transition-all text-sm">Каталог <span aria-hidden="true">→</span></a>
      </div>

      <div class="space-y-8">
        {tomatoGroups.map((group) => (
          <div>
            <div class="flex items-baseline gap-2 mb-3 pb-2 border-b border-[var(--color-border)]">
              <h3 class="text-xl sm:text-2xl font-bold">{group.baseName}</h3>
              <span class="text-sm text-[var(--color-muted)]">
                {group.photos.length} фото
                {(() => {
                  const variants = [...new Set(group.photos.map((p) => p.variantLabel).filter(Boolean))];
                  return variants.length > 0 ? ` · ${variants.join(', ')}` : '';
                })()}
              </span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 sm:gap-3">
              {group.photos.map((photo) => (
                <a
                  href={`${categoryPath(group.category)}/${photo.slug}`}
                  class="card-hover group relative block aspect-square overflow-hidden rounded-xl ring-1 ring-black/5 bg-[var(--color-bg)]"
                >
                  <Image
                    src={photo.image}
                    alt={`${photo.fullName}${photo.index > 0 ? ` — фото ${photo.index + 1}` : ''}`}
                    widths={[240, 360, 480]}
                    sizes="(max-width: 640px) 50vw, (max-width: 768px) 33vw, 25vw"
                    loading="lazy"
                    class="absolute inset-0 object-cover group-hover:scale-[1.05] transition-transform duration-500 ease-out"
                    style="width: 100%; height: 100%; object-position: center 60%;"
                  />
                  {photo.variantLabel && (
                    <span class="absolute top-2 left-2 inline-flex items-center px-2 py-0.5 rounded-full bg-white/90 backdrop-blur text-xs font-semibold text-[var(--color-text)] ring-1 ring-black/5">
                      {photo.variantLabel}
                    </span>
                  )}
                  <div class="absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-black/55 via-black/15 to-transparent pointer-events-none" aria-hidden="true"></div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <div class="flex items-end justify-between gap-4 mb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold flex items-center gap-2">
          <span aria-hidden="true">🌶️</span>
          Перці
          <span class="text-base font-medium text-[var(--color-muted)] ml-1">· {pepperGroups.length} сорт{pepperGroups.length === 1 ? '' : 'ів'}</span>
        </h2>
        <a href="/pertsi" class="hidden sm:inline-flex items-center gap-1 text-[var(--color-pepper)] font-semibold hover:gap-2 transition-all text-sm">Каталог <span aria-hidden="true">→</span></a>
      </div>

      <div class="space-y-8">
        {pepperGroups.map((group) => (
          <div>
            <div class="flex items-baseline gap-2 mb-3 pb-2 border-b border-[var(--color-border)]">
              <h3 class="text-xl sm:text-2xl font-bold">{group.baseName}</h3>
              <span class="text-sm text-[var(--color-muted)]">
                {group.photos.length} фото
                {(() => {
                  const variants = [...new Set(group.photos.map((p) => p.variantLabel).filter(Boolean))];
                  return variants.length > 0 ? ` · ${variants.join(', ')}` : '';
                })()}
              </span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 sm:gap-3">
              {group.photos.map((photo) => (
                <a
                  href={`${categoryPath(group.category)}/${photo.slug}`}
                  class="card-hover group relative block aspect-square overflow-hidden rounded-xl ring-1 ring-black/5 bg-[var(--color-bg)]"
                >
                  <Image
                    src={photo.image}
                    alt={`${photo.fullName}${photo.index > 0 ? ` — фото ${photo.index + 1}` : ''}`}
                    widths={[240, 360, 480]}
                    sizes="(max-width: 640px) 50vw, (max-width: 768px) 33vw, 25vw"
                    loading="lazy"
                    class="absolute inset-0 object-cover group-hover:scale-[1.05] transition-transform duration-500 ease-out"
                    style="width: 100%; height: 100%; object-position: center 60%;"
                  />
                  {photo.variantLabel && (
                    <span class="absolute top-2 left-2 inline-flex items-center px-2 py-0.5 rounded-full bg-white/90 backdrop-blur text-xs font-semibold text-[var(--color-text)] ring-1 ring-black/5">
                      {photo.variantLabel}
                    </span>
                  )}
                  <div class="absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-black/55 via-black/15 to-transparent pointer-events-none" aria-hidden="true"></div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </article>
</Base>
