---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getVarietyImages } from '../lib/images';
import { categoryPath } from '../lib/labels';

const all = await getCollection('varieties');

type Photo = {
  slug: string;
  fullName: string;
  image: any;
  index: number;
};

const sorted = [...all].sort((a, b) => a.data.name.localeCompare(b.data.name, 'uk'));

const tomatoPhotos: Photo[] = [];
const pepperPhotos: Photo[] = [];

for (const v of sorted) {
  const images = getVarietyImages(v.data.slug);
  images.forEach((img, i) => {
    const photo: Photo = {
      slug: v.data.slug,
      fullName: v.data.name,
      image: img,
      index: i,
    };
    if (v.data.category === 'tomato') tomatoPhotos.push(photo);
    else pepperPhotos.push(photo);
  });
}

const totalPhotos = tomatoPhotos.length + pepperPhotos.length;
const tomatoSorts = new Set(tomatoPhotos.map((p) => p.slug)).size;
const pepperSorts = new Set(pepperPhotos.map((p) => p.slug)).size;
---
<Base
  title="Галерея"
  description="Усі фото сортів помідорів і перцю — каталог Ігоря, Львів."
>
  <article class="max-w-6xl mx-auto px-4 py-10 sm:py-14">
    <nav class="text-sm text-[var(--color-muted)] mb-4">
      <a href="/" class="hover:underline">Головна</a> <span aria-hidden="true">›</span> Галерея
    </nav>
    <span class="section-eyebrow">Фото · {totalPhotos} знімків · {tomatoSorts + pepperSorts} сортів</span>
    <h1 class="text-4xl sm:text-5xl font-extrabold mb-3">Галерея</h1>
    <p class="text-lg text-[var(--color-muted)] mb-8 max-w-2xl">
      Усі фото сортів — справжні кущі та плоди з мого городу. Натисни на фото — побачиш повний опис сорту.
    </p>

    <div class="flex flex-wrap gap-2 mb-10">
      <a href="#pomidory" class="chip"><span aria-hidden="true">🍅</span> Помідори · {tomatoSorts}</a>
      <a href="#pertsi" class="chip"><span aria-hidden="true">🌶️</span> Перці · {pepperSorts}</a>
    </div>

    <section id="pomidory" class="mb-14 scroll-mt-24">
      <div class="flex items-end justify-between gap-4 mb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold flex items-center gap-2">
          <span class="size-9 rounded-xl bg-[#FEE2E2] flex items-center justify-center text-xl" aria-hidden="true">🍅</span>
          Помідори
          <span class="text-base font-medium text-[var(--color-muted)] ml-1">· {tomatoSorts} {tomatoSorts === 1 ? 'сорт' : 'сорти'}</span>
        </h2>
        <a href="/pomidory" class="hidden sm:inline-flex items-center gap-1 text-[var(--color-tomato-dark)] font-semibold hover:gap-2 transition-all text-sm">Каталог <span aria-hidden="true">→</span></a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 sm:gap-3">
        {tomatoPhotos.map((photo) => (
          <a
            href={`${categoryPath('tomato')}/${photo.slug}`}
            class="card-hover group relative block aspect-square overflow-hidden rounded-xl ring-1 ring-black/5 bg-[var(--color-bg)]"
          >
            <Image
              src={photo.image}
              alt={`${photo.fullName}${photo.index > 0 ? ` — фото ${photo.index + 1}` : ''}`}
              widths={[240, 360, 480]}
              sizes="(max-width: 640px) 50vw, (max-width: 768px) 33vw, 25vw"
              loading="lazy"
              class="absolute inset-0 object-cover group-hover:scale-[1.05] transition-transform duration-500 ease-out"
              style="width: 100%; height: 100%; object-position: center 60%;"
            />
            <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/55 via-black/15 to-transparent pointer-events-none" aria-hidden="true"></div>
            <h3 class="absolute inset-x-2.5 bottom-2 text-white font-bold text-sm sm:text-base leading-tight drop-shadow-[0_2px_4px_rgba(0,0,0,0.7)]">
              {photo.fullName}
            </h3>
          </a>
        ))}
      </div>
    </section>

    <section id="pertsi" class="scroll-mt-24">
      <div class="flex items-end justify-between gap-4 mb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold flex items-center gap-2">
          <span class="size-9 rounded-xl bg-[#FED7AA] flex items-center justify-center text-xl" aria-hidden="true">🌶️</span>
          Перці
          <span class="text-base font-medium text-[var(--color-muted)] ml-1">· {pepperSorts} {pepperSorts === 1 ? 'сорт' : 'сорти'}</span>
        </h2>
        <a href="/pertsi" class="hidden sm:inline-flex items-center gap-1 text-[var(--color-pepper)] font-semibold hover:gap-2 transition-all text-sm">Каталог <span aria-hidden="true">→</span></a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 sm:gap-3">
        {pepperPhotos.map((photo) => (
          <a
            href={`${categoryPath('pepper')}/${photo.slug}`}
            class="card-hover group relative block aspect-square overflow-hidden rounded-xl ring-1 ring-black/5 bg-[var(--color-bg)]"
          >
            <Image
              src={photo.image}
              alt={`${photo.fullName}${photo.index > 0 ? ` — фото ${photo.index + 1}` : ''}`}
              widths={[240, 360, 480]}
              sizes="(max-width: 640px) 50vw, (max-width: 768px) 33vw, 25vw"
              loading="lazy"
              class="absolute inset-0 object-cover group-hover:scale-[1.05] transition-transform duration-500 ease-out"
              style="width: 100%; height: 100%; object-position: center 60%;"
            />
            <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/55 via-black/15 to-transparent pointer-events-none" aria-hidden="true"></div>
            <h3 class="absolute inset-x-2.5 bottom-2 text-white font-bold text-sm sm:text-base leading-tight drop-shadow-[0_2px_4px_rgba(0,0,0,0.7)]">
              {photo.fullName}
            </h3>
          </a>
        ))}
      </div>
    </section>
  </article>
</Base>
